// Delhi Broker CRM - Database Schema
// PostgreSQL (Phase 3A migration). Previously SQLite for local MVP dev - see
// DEPLOYMENT.md "PostgreSQL Migration" and prisma/migrations.sqlite-archive/
// for the pre-migration history. Local dev now runs Postgres via
// `docker compose up -d` (docker-compose.yml) instead of a SQLite file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

