// ---------------------------------------------------------------------------
// Property Catalogue Sharing (Phase 2B)
// ---------------------------------------------------------------------------

model CatalogueShare {
  id               String                @id @default(cuid())
  organizationId   String                @default("org_default")
  organization     Organization          @relation(fields: [organizationId], references: [id])
  token            String                @unique
  leadId           String
  lead             Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversationId   String?
  conversation     WhatsAppConversation? @relation(fields: [conversationId], references: [id])
  createdByUserId  String?
  createdBy        User?                 @relation(fields: [createdByUserId], references: [id])
  title            String
  introMessage     String?
  includePrice     Boolean               @default(true)
  includeAddress   Boolean               @default(false)
  includeBrokerage Boolean               @default(false)
  status           CatalogueStatus       @default(ACTIVE)
  expiresAt        DateTime?
  viewCount        Int                   @default(0)
  lastViewedAt     DateTime?
  version          Int                   @default(1) // Phase 4 - bumped whenever a property is removed/added post-send; token stays stable so "latest version" just means the current active property set
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  properties    CatalogueShareProperty[]
  interactions  CatalogueInteraction[]
  versionEvents CatalogueVersionEvent[]
  visits        Visit[]

  @@index([organizationId, leadId])
  @@map("catalogue_shares")
}

model CatalogueShareProperty {
  id               String         @id @default(cuid())
  catalogueShareId String
  catalogueShare   CatalogueShare @relation(fields: [catalogueShareId], references: [id], onDelete: Cascade)
  propertyId       String
  property         Property       @relation(fields: [propertyId], references: [id])
  sortOrder        Int            @default(0)
  customNote       String?
  internalNote     String?
  priceVisible     Boolean        @default(true)
  addressVisible   Boolean        @default(false)
  brokerageVisible Boolean        @default(false)
  isTopPick        Boolean        @default(false)
  addedManually    Boolean        @default(false)
  addedByUserId    String?
  addedByUser      User?          @relation(fields: [addedByUserId], references: [id])
  createdAt        DateTime       @default(now())

  // Phase 4 - executive per-property engagement checklist
  executiveStatus            CatalogueExecutiveStatus @default(PENDING)
  executiveStatusUpdatedAt   DateTime?
  executiveStatusUpdatedById String?
  executiveStatusUpdatedBy   User?                    @relation("CatalogueExecutiveStatusUpdatedBy", fields: [executiveStatusUpdatedById], references: [id])
  executiveStatusNote        String?

  // Phase 4 - catalogue versioning (soft-removal, never a hard delete -
  // existing CatalogueInteraction rows reference propertyId and must stay valid)
  removedAt     DateTime?
  removedReason String?

  @@unique([catalogueShareId, propertyId])
  @@map("catalogue_share_properties")
}

enum CatalogueExecutiveStatus {
  PENDING
  SHOWN
  CUSTOMER_LIKED
  SHORTLISTED
  REJECTED
}

model CatalogueInteraction {
  id               String                   @id @default(cuid())
  organizationId   String                   @default("org_default")
  organization     Organization             @relation(fields: [organizationId], references: [id])
  catalogueShareId String
  catalogueShare   CatalogueShare           @relation(fields: [catalogueShareId], references: [id], onDelete: Cascade)
  propertyId       String?
  property         Property?                @relation(fields: [propertyId], references: [id])
  type             CatalogueInteractionType
  message          String?
  clientName       String?
  clientPhone      String?
  metadata         String? // JSON blob - e.g. { dedupeKey, preferredDate, preferredWindow }
  createdAt        DateTime                 @default(now())

  // Catalogue -> Visit workflow.
  //
  // A VISIT_REQUESTED interaction IS the client's visit request. The public
  // catalogue page never books anything: it records this row plus a
  // VISIT_CONFIRMATION FollowUp, and nothing else. No Visit exists until an
  // Admin reviews the request and presses [Confirm Visit]; the confirmed
  // Visit is then stamped here.
  //
  // `scheduledVisitId` doubles as the single-use guard. Confirmation claims
  // the request rows with a guarded `updateMany ... where scheduledVisitId is
  // null` inside the same transaction that creates the Visit - the same
  // idiom completePasswordReset uses to consume a reset token exactly once.
  // A racing second confirmation claims 0 rows, throws, and rolls back its
  // whole transaction (the Visit included), so a double-submit can never
  // produce two Visits for one request.
  scheduledVisitId String?
  scheduledVisit   Visit?                   @relation("VisitFromCatalogueRequest", fields: [scheduledVisitId], references: [id])
  scheduledAt      DateTime?
  scheduledById    String?
  scheduledBy      User?                    @relation("CatalogueRequestScheduledBy", fields: [scheduledById], references: [id])

  @@index([catalogueShareId, type])
  @@index([organizationId, type, scheduledVisitId])
  @@map("catalogue_interactions")
}

