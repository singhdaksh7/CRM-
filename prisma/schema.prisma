  rowNumber        Int
  status           ImportRecordStatus
  rawData          String // JSON of the source row
  errorMessage     String?
  entityId         String? // id of the created record, if imported
  action           PropertyImportAction?
  duplicateClass   PropertyDuplicateClass?
  validationErrors String?
  warnings         String?
  beforeSummary    String?
  afterSummary     String?
  createdAt        DateTime                @default(now())

  @@index([importJobId, status])
  @@map("import_records")
}

model ImportMappingPreset {
  id              String           @id @default(cuid())
  organizationId  String           @default("org_default")
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  entityType      ImportEntityType @default(PROPERTIES)
  headerSignature String
  columnMapping   String
  createdById     String?
  createdBy       User?            @relation("ImportMappingPresetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, entityType])
  @@index([organizationId, headerSignature])
  @@map("import_mapping_presets")
}

// ---------------------------------------------------------------------------
// Audit Logs (Phase 1, Module 7)
