  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  ownerId    String?
  owner      Owner?    @relation(fields: [ownerId], references: [id])

  agreedAmount            Int?
  brokeragePct            Float?
  brokerageAmount         Int?
  // Internal reporting only. These fields do not represent collection,
  // invoicing, payment status, or a payment instruction of any kind.
  expectedBrokerageAmount Int?
  kpSharePct              Float?
  partnerSharePct         Float?
  closingNotes            String?

