// ---------------------------------------------------------------------------
// Multi-tenant foundation (Phase 2A)
//
// Every major record is scoped to an Organization so the product can become
// multi-tenant SaaS later without another data migration. For this single-
// brokerage installation, all existing + new rows default to `org_default`,
// backfilled automatically by the literal @default below (see README
// "Migrating to multi-tenant" section for how a second org would be added).
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  phone     String?
  email     String?
  address   String?
  timezone  String   @default("Asia/Kolkata")
  currency  String   @default("INR")
  settings  String   @default("{}") // JSON blob: assignment defaults, branding, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                       User[]
  properties                  Property[]
  leads                       Lead[]
  propertyPortalConnections   PropertyPortalConnection[]
  portalListings              PortalListing[]
  portalOperations            PortalOperation[]
  externalLeadEvents          ExternalLeadEvent[]
  leadTransfers               LeadTransfer[]
  sharedPropertyLogs          SharedPropertyLog[]
  visits                      Visit[]
  visitProperties             VisitProperty[]
  followUps                   FollowUp[]
  activities                  Activity[]
  notifications               Notification[]
  assignmentRules             LeadAssignmentRule[]
  employeeServiceAreas        EmployeeServiceArea[]
  leadScoreHistory            LeadScoreHistory[]
  whatsappConversations       WhatsAppConversation[]
  whatsappMessages            WhatsAppMessage[]
  catalogueShares             CatalogueShare[]
  catalogueInteractions       CatalogueInteraction[]
  webhookEvents               IntegrationWebhookEvent[]
  owners                      Owner[]
  deals                       Deal[]
  brokerageCalculations       BrokerageCalculation[]
  payments                    Payment[]
  documents                   Document[]
  propertyImages              PropertyImage[]
  storageUploadSessions       StorageUploadSession[]
  importJobs                  ImportJob[]
  importMappingPresets        ImportMappingPreset[]
  auditLogs                   AuditLog[]
  backupRecords               BackupRecord[]
  restoreValidations          RestoreValidation[]
  savedViews                  SavedView[]
  systemConfig                SystemConfig?
  automationRules             AutomationRule[]
  inventoryPartners           InventoryPartner[]
  propertyTimelineEvents      PropertyTimelineEvent[]
  propertyAvailabilityReports PropertyAvailabilityReport[]
  propertyReports             PropertyReport[]
  visitFeedback               VisitFeedback[]
  leadAssignmentHistory       LeadAssignmentHistory[]
  catalogueVersionEvents      CatalogueVersionEvent[]
  dealOffers                  DealOffer[]
  requirementBroadcasts       RequirementBroadcast[]
  matchRecommendations        MatchRecommendation[]
  accountSetupTokens          AccountSetupToken[]
  passwordResetTokens         PasswordResetToken[]
  customerContacts            CustomerContact[]
  customerRequirements        CustomerRequirement[]
  propertyRecommendations     PropertyRecommendation[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Auth / Employees
// ---------------------------------------------------------------------------

model User {
  id             String         @id @default(cuid())
  organizationId String         @default("org_default")
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  email          String         @unique
  passwordHash   String
  phone          String?
  role           Role
  status         EmployeeStatus @default(ACTIVE)
  notes          String?

  // Session revocation counter. Every credential/lifecycle event that must
  // invalidate previously-issued JWTs (password reset, password change,
  // admin disabling the account) increments this; the Auth.js `jwt` callback
  // compares the value baked into the token against the row and drops the
  // session on a mismatch. Starts at 1 so a token carrying an absent/0
  // version can never accidentally match.
  authVersion Int       @default(1)
  // Set only on a successful credential authentication.
  lastLoginAt DateTime?

  // Auto-assignment profile (Phase 2A)
  maxActiveLeads    Int                @default(20)
  isAvailable       Boolean            @default(true)
  speciality        EmployeeSpeciality @default(ALL)
  autoAssignEnabled Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedLeads                 Lead[]                   @relation("AssignedEmployee")
  assignedVisits                Visit[]                  @relation("AssignedFieldExecutive")
  visitConflictOverrides        Visit[]                  @relation("VisitConflictOverrideBy")
  createdVisits                 Visit[]                  @relation("VisitCreatedBy")
  visitPropertiesVisited        VisitProperty[]          @relation("VisitPropertyVisitedBy")
  scheduledCatalogueRequests    CatalogueInteraction[]   @relation("CatalogueRequestScheduledBy")
  followUps                     FollowUp[]               @relation("FollowUpOwner")
  activities                    Activity[]               @relation("ActivityActor")
  sharedProperties              SharedPropertyLog[]      @relation("SharedBy")
  leadTransfersFrom             LeadTransfer[]           @relation("TransferFrom")
  leadTransfersTo               LeadTransfer[]           @relation("TransferTo")
  propertiesAdded               Property[]               @relation("PropertyCreatedBy")
  serviceAreas                  EmployeeServiceArea[]
  assignmentRules               LeadAssignmentRule[]     @relation("AssignmentRuleEmployee")
  notifications                 Notification[]
  whatsappMessagesSent          WhatsAppMessage[]
  whatsappConversationsAssigned WhatsAppConversation[]   @relation("WhatsAppConversationAssignee")
  cataloguesCreated             CatalogueShare[]
  catalogueShareProperties      CatalogueShareProperty[]
  ownersCreated                 Owner[]                  @relation("OwnerCreatedBy")
  ownersVerified                Owner[]                  @relation("OwnerVerifiedBy")
  dealsAssigned                 Deal[]                   @relation("DealAssignedTo")
  dealsCreated                  Deal[]                   @relation("DealCreatedBy")
  brokerageCalculationsMade     BrokerageCalculation[]   @relation("BrokerageCalculatedBy")
  brokerageIncentives           BrokerageCalculation[]   @relation("BrokerageIncentiveEmployee")
  paymentsRecorded              Payment[]                @relation("PaymentRecordedBy")
  documentsUploaded             Document[]               @relation("DocumentUploadedBy")
  propertyImagesUploaded        PropertyImage[]          @relation("PropertyImageUploadedBy")
  importJobsCreated             ImportJob[]              @relation("ImportJobCreatedBy")
  importMappingPresetsCreated   ImportMappingPreset[]    @relation("ImportMappingPresetCreatedBy")
  auditLogs                     AuditLog[]
  backupsTriggered              BackupRecord[]           @relation("BackupTriggeredBy")
  restoreValidationsDone        RestoreValidation[]      @relation("RestoreValidatedBy")
  savedViews                    SavedView[]
  systemConfigsUpdated          SystemConfig[]
  automationRulesCreated        AutomationRule[]

  // Phase 4 - Field Operations
  inventoryPartnersCreated        InventoryPartner[]           @relation("InventoryPartnerCreatedBy")
  propertiesLastVerified          Property[]                   @relation("PropertyLastVerifiedBy")
  propertyTimelineEventsActed     PropertyTimelineEvent[]      @relation("PropertyTimelineEventActor")
  availabilityReportsSubmitted    PropertyAvailabilityReport[] @relation("AvailabilityReportedBy")
  availabilityReportsReviewed     PropertyAvailabilityReport[] @relation("AvailabilityReportReviewedBy")
  propertyReportsSubmitted        PropertyReport[]             @relation("PropertyReportedBy")
  propertyReportsResolved         PropertyReport[]             @relation("PropertyReportResolvedBy")
  visitFeedbackSubmitted          VisitFeedback[]              @relation("VisitFeedbackSubmittedBy")
  leadAssignmentHistoryTo         LeadAssignmentHistory[]      @relation("AssignmentHistoryTo")
  catalogueExecutiveStatusUpdates CatalogueShareProperty[]     @relation("CatalogueExecutiveStatusUpdatedBy")
  catalogueVersionEventsActed     CatalogueVersionEvent[]      @relation("CatalogueVersionEventActor")
  propertyFavorites               PropertyFavorite[]
  propertyViewLogs                PropertyViewLog[]
  dealOffers                      DealOffer[]
  requirementBroadcasts           RequirementBroadcast[]
  matchRecommendations            MatchRecommendation[]
  accountSetupTokens              AccountSetupToken[]
  passwordResetTokens             PasswordResetToken[]
  customerContactsCreated          CustomerContact[]         @relation("CustomerContactCreatedBy")
  customerRequirementsCreated      CustomerRequirement[]     @relation("CustomerRequirementCreatedBy")
  propertyRecommendationsCreated   PropertyRecommendation[]  @relation("PropertyRecommendationCreatedBy")
  propertyRecommendationsResponded PropertyRecommendation[]  @relation("PropertyRecommendationRespondedBy")

  @@map("users")
}

model AccountSetupToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, userId])
  @@index([expiresAt])
  @@map("account_setup_tokens")
}

// Deliberately a separate table from AccountSetupToken: a setup token proves
// "this account has never had a password", a reset token proves "this active
// account asked for a new one". Reusing one table would let an expired setup
// link be resurrected as a reset link (and vice versa). Only the SHA-256
// hash of the token is stored - the plaintext exists solely in the HTTP
// response that issues it and is never recoverable afterwards.
model PasswordResetToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Automatic lead assignment (Phase 2A)
// ---------------------------------------------------------------------------

model LeadAssignmentRule {
  id              String             @id @default(cuid())
  organizationId  String             @default("org_default")
  organization    Organization       @relation(fields: [organizationId], references: [id])
  name            String
  strategy        AssignmentStrategy
  source          LeadSource?
  requirementType RequirementType?
  locality        String?
  employeeId      String?
  employee        User?              @relation("AssignmentRuleEmployee", fields: [employeeId], references: [id])
  priority        Int                @default(0)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("lead_assignment_rules")
}

model EmployeeServiceArea {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       User         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  locality       String
  city           String       @default("Delhi")
  priority       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([employeeId, locality])
  @@map("employee_service_areas")
}

// ---------------------------------------------------------------------------
// Notification Centre (Phase 2A)
// ---------------------------------------------------------------------------

model Notification {
  id                 String            @id @default(cuid())
  organizationId     String            @default("org_default")
  organization       Organization      @relation(fields: [organizationId], references: [id])
  userId             String?
  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               Role?
  type               NotificationType
  title              String
  message            String
  leadId             String?
  visitId            String?
  propertyId         String?
  followUpId         String?
  inventoryPartnerId String? // Phase 4 - Field Operations
  inventoryPartner   InventoryPartner? @relation(fields: [inventoryPartnerId], references: [id])
  isRead             Boolean           @default(false)
  readAt             DateTime?
  createdAt          DateTime          @default(now())

  @@index([userId, isRead])
  @@index([role, isRead])
  // Serves searchNotifications() in src/lib/search/entity-search.ts, now
  // that it carries an organizationId predicate (see org-isolation audit) -
  // no existing index covered organizationId at all.
  @@index([organizationId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Property Inventory
// ---------------------------------------------------------------------------

model Property {
  id             String         @id @default(cuid())
  organizationId String         @default("org_default")
  organization   Organization   @relation(fields: [organizationId], references: [id])
  propertyCode   String         @unique
  title          String
  propertyType   PropertyType
  listingType    ListingType
  assetClass     AssetClass     @default(RESIDENTIAL)
  status         PropertyStatus @default(AVAILABLE)
  description    String

  // Location
  city      String  @default("Delhi")
  area      String
  address   String
  landmark  String?
  latitude  Float?
  longitude Float?

  // Maps & Localities phase - additive location metadata. None of this is
  // populated automatically; geocoding only ever runs on an explicit user
  // action (address search / "Re-geocode"), never silently in the background.
  pincode            String?
  formattedAddress   String? // Google's canonical formatted_address, kept separate from the user-entered `address`
  placeId            String? // Google Place ID - lets a re-geocode reuse the exact same place instead of a fresh text search
  geocodeStatus      GeocodeStatus     @default(NOT_ATTEMPTED)
  geocodedAt         DateTime?
  locationPrecision  LocationPrecision @default(APPROXIMATE) // how precise the stored lat/lng actually is
  publicLocationMode LocationPrecision @default(LOCALITY_ONLY) // what the public catalogue is allowed to reveal - independent of locationPrecision, defaults to the safest option

  // Rental pricing
  monthlyRent       Int?
  securityDeposit   Int?
  maintenanceCharge Int?
  rentBrokerage     Int?

  // Sale pricing
  salePrice           Int?
  pricePerSqft        Int?
  saleBrokeragePct    Float?
  saleBrokerageAmount Int?

  negotiable Boolean @default(false)

  // Property details
  bhk              Int
  bathrooms        Int
  balconies        Int               @default(0)
  furnishing       FurnishingStatus
  floorNumber      Int?
  totalFloors      Int?
  propertyAgeYears Int?
  builtUpAreaSqft  Int
  carpetAreaSqft   Int?
  dimension        String?
  possessionNotes  String?
  facing           Facing?
  parkingAvailable Boolean           @default(false)
  liftAvailable    Boolean           @default(false)
  tenantPreference TenantPreference?
  availableFrom    DateTime?
  amenities        String            @default("[]") // JSON array of strings
  tags             String            @default("[]") // JSON array of strings - free-form labels (Phase 2 bulk tagging), same pattern as amenities

  // Commercial details are optional and deliberately separate from BHK data.
  superAreaSqft            Int?
  frontageFeet             Float?
  ceilingHeightFeet        Float?
  cabins                   Int?
  workstations             Int?
  washrooms                Int?
  pantryAvailable          Boolean           @default(false)
  powerLoadKw              Float?
  commercialFitOut         CommercialFitOut?
  goodsLiftAvailable       Boolean           @default(false)
  loadingAccessAvailable   Boolean           @default(false)
  roadWidthFeet            Float?
  cornerProperty           Boolean           @default(false)
  fireSafetyAvailable      Boolean           @default(false)
  suitableForTags          String            @default("[]")
  leaseTermMonths          Int?
  lockInPeriodMonths       Int?
  noticePeriodMonths       Int?
  escalationPercentage     Float?
  escalationIntervalMonths Int?
  fitOutPeriodDays         Int?
  camCharge                Int?
  expectedPrice            Int?
  ownershipTitleNotes      String?

  // Media
  images         String  @default("[]") // JSON array of URLs
  coverImage     String?
  videoUrl       String?
  virtualTourUrl String?
  floorPlanImage String?

  // Owner (private - never exposed on public page)
  // ownerName/ownerPhone remain the source of truth for legacy properties;
  // ownerId links to a full Owner CRM record when one exists (Phase 1).
  // Phase 4: made nullable - an INDIRECT property (see inventorySource
  // below) legitimately has no owner at all, only an InventoryPartner.
  // createPropertySchema still requires these for DIRECT inventory.
  ownerName           String?
  ownerPhone          String?
  ownerAlternatePhone String?
  ownerNotes          String?
  ownerId             String?
  owner               Owner?  @relation(fields: [ownerId], references: [id])

  // Phase 4 - Field Operations: Direct vs Indirect inventory
  inventorySource InventorySource   @default(DIRECT)
  partnerId       String?
  partner         InventoryPartner? @relation(fields: [partnerId], references: [id])

  // Phase 4 - Internal Property View (never in customer-facing catalogue DTOs)
  buildingName      String?
  flatNumber        String?
  gateNumber        String?
  propertySource    String?
  keyAvailability   String?
  entryInstructions String?
  internalNotes     String?
  negotiationNotes  String?
  hiddenRemarks     String?
  imagesUpdatedAt   DateTime?

  // Phase 4 - Availability Verification
  pendingVerification Boolean @default(false)

  // Phase 4 - Property Last Verified
  lastVerifiedAt   DateTime?
  lastVerifiedById String?
  lastVerifiedBy   User?     @relation("PropertyLastVerifiedBy", fields: [lastVerifiedById], references: [id])

  createdById String?
  createdBy   User?    @relation("PropertyCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sharedIn                 SharedPropertyLog[]
  visits                   Visit[]
  visitProperties          VisitProperty[]
  catalogueShareProperties CatalogueShareProperty[]
  catalogueInteractions    CatalogueInteraction[]
  deals                    Deal[]
  documents                Document[]
  propertyImages           PropertyImage[]
  timelineEvents           PropertyTimelineEvent[]
  availabilityReports      PropertyAvailabilityReport[]
  reports                  PropertyReport[]
  matchRecommendations     MatchRecommendation[]
  favoritedBy              PropertyFavorite[]
  viewLogs                 PropertyViewLog[]
  portalListings           PortalListing[]
  demandRecommendations    PropertyRecommendation[]

  @@index([ownerId])
  @@index([organizationId, status])
  @@index([organizationId, assetClass, listingType])
  @@index([organizationId, inventorySource])
  @@index([partnerId])
  // GET /api/properties and the /properties list page default-sort
  // newest-first; both gained an organizationId predicate as part of the
  // org-isolation audit (previously missing it entirely - the actual
  // vulnerability, not just a performance gap).
  @@index([organizationId, createdAt])
  // propertiesByLocation (dashboard-data.ts) and propertiesByArea/
  // propertiesByBhk (locality-analytics-data.ts) groupBy area/bhk, both
  // now organizationId-scoped for the same reason.
  @@index([organizationId, area])
  @@index([organizationId, bhk])
  @@map("properties")
}

enum InventorySource {
  DIRECT
  INDIRECT
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

model Lead {
  id                String                  @id @default(cuid())
  organizationId    String                  @default("org_default")
  organization      Organization            @relation(fields: [organizationId], references: [id])
  leadCode          String                  @unique
  clientName        String
  phone             String
  email             String?
  source            LeadSource
  externalLeadId    String?                 @unique // dedupe key for webhook leads
  assetClass        AssetClass              @default(RESIDENTIAL)
  transactionType   TransactionType         @default(RENT)
  portalProvider    PropertyPortalProvider?
  externalListingId String?
  rawPayloadHash    String?
  receivedAt        DateTime?

  requirementType        RequirementType
  preferredLocation      String
  minBudget              Int
  maxBudget              Int
  preferredBhk           Int?
  furnishingPref         FurnishingStatus?
  moveInDate             DateTime?
  additionalRequirements String?
  commercialPropertyType PropertyType?
  minAreaSqft            Int?
  maxAreaSqft            Int?
  floorPreference        String?
  commercialFitOutPref   CommercialFitOut?
  parkingRequired        Boolean?
  liftRequired           Boolean?
  suitableForTags        String            @default("[]")

  assignedToId String?
  assignedTo   User?   @relation("AssignedEmployee", fields: [assignedToId], references: [id])

  status   LeadStatus   @default(NEW)
  priority LeadPriority @default(WARM)

  // Auto-assignment (Phase 2A)
  assignmentStrategy AssignmentStrategy?
  assignmentReason   String?
  autoAssignedAt     DateTime?

  // Lead scoring (Phase 2A)
  score            Int       @default(0)
  scoreExplanation String? // JSON array of {label, delta, reason}
  scoreUpdatedAt   DateTime?

  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  notes           String?

  // Demand pool linkage (Phase: Demand Pool + Matching) - when this Lead
  // originated from (or was later linked to) a long-term CustomerContact,
  // never a duplicate identity. See CustomerContact.leads.
  customerContactId String?
  customerContact   CustomerContact? @relation("LeadCustomerContact", fields: [customerContactId], references: [id])
  // Set only when this Lead was created via [Create Lead from Requirement];
  // the inverse FK lives on CustomerRequirement.convertedLeadId (1:1).
  convertedFromRequirement CustomerRequirement? @relation("LeadFromRequirement")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities              Activity[]
  followUps               FollowUp[]
  visits                  Visit[]
  sharedProperties        SharedPropertyLog[]
  transfers               LeadTransfer[]
  scoreHistory            LeadScoreHistory[]
  whatsappConversations   WhatsAppConversation[]
  catalogueShares         CatalogueShare[]
  deals                   Deal[]
  documents               Document[]
  assignmentHistory       LeadAssignmentHistory[]
  requirementBroadcasts   RequirementBroadcast[]
  matchRecommendations    MatchRecommendation[]
  externalLeadEvents      ExternalLeadEvent[]
  propertyRecommendations PropertyRecommendation[] @relation("PropertyRecommendationLead")

  @@index([organizationId, customerContactId])
  @@index([organizationId, phone])
  @@index([organizationId, assignedToId])
  @@index([organizationId, assetClass, transactionType])
  @@index([organizationId, portalProvider, externalLeadId])
  // The three indexes below serve dashboard-data.ts queries that gained an
  // organizationId predicate as part of the org-isolation audit (they were
  // previously missing it entirely, which was itself the vulnerability -
  // see the audit report). Sized to the literal shape of each query:
  // - newLeadsToday: organizationId + createdAt range
  // - dealsClosedThisMonth: organizationId + status + updatedAt range
  // - leadsBySource: organizationId + groupBy column
  // - leadsByStatus: organizationId + groupBy(status) - deliberately NOT a
  //   separate [organizationId, status] index; [organizationId, status,
  //   updatedAt] below already serves any query filtering/grouping on just
  //   the (organizationId, status) prefix, so a narrower index here would
  //   be pure write-amplification with no read benefit.
  @@index([organizationId, createdAt])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, source])
  @@map("leads")
}

/// Provider configuration never stores raw credentials. `credentialReference`
/// is an opaque key for a future secret manager / authorized feed.
model PropertyPortalConnection {
  id                   String                 @id @default(cuid())
  organizationId       String                 @default("org_default")
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider             PropertyPortalProvider
  status               PortalConnectionStatus @default(NOT_CONFIGURED)
  connectionMode       PortalConnectionMode   @default(MANUAL)
  displayName          String?
  accountReference     String?
  credentialReference  String?
  config               String                 @default("{}")
  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  lastErrorAt          DateTime?
  lastErrorSummary     String?
  createdById          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  listings             PortalListing[]
  events               ExternalLeadEvent[]
  operations           PortalOperation[]

  @@unique([organizationId, provider, accountReference])
  @@index([organizationId, provider, status])
  @@map("property_portal_connections")
}

model PortalListing {
  id                   String                    @id @default(cuid())
  organizationId       String                    @default("org_default")
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId         String?
  connection           PropertyPortalConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  propertyId           String
  property             Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  provider             PropertyPortalProvider
  externalListingId    String?
  externalUrl          String?
  status               PortalListingStatus       @default(DRAFT)
  publishedAt          DateTime?
  lastSyncedAt         DateTime?
  payloadHash          String?
  payloadVersion       Int                       @default(1)
  errorSummary         String?
  conflictFields       String? // JSON of supported fields that differ; never applied implicitly
  portalSnapshot       String? // redacted provider state used only for human review
  conflictDetectedAt   DateTime?
  conflictResolvedAt   DateTime?
  conflictResolution   PortalConflictResolution?
  conflictResolvedById String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  events               ExternalLeadEvent[]
  operations           PortalOperation[]

  @@unique([organizationId, provider, externalListingId])
  @@index([organizationId, propertyId, provider])
  @@map("portal_listings")
}

/// Internal operation ledger. Contract-only providers never execute network calls here;
/// the ledger makes manual/authorized adapters safely retryable and auditable.
model PortalOperation {
  id              String                    @id @default(cuid())
  organizationId  String                    @default("org_default")
  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portalListingId String?
  portalListing   PortalListing?            @relation(fields: [portalListingId], references: [id], onDelete: SetNull)
  connectionId    String?
  connection      PropertyPortalConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider        PropertyPortalProvider
  operationType   String
  idempotencyKey  String
  status          PortalOperationStatus     @default(PENDING)
  failureReason   String?
  attemptCount    Int                       @default(0)
  lastAttemptAt   DateTime?
  retryEligibleAt DateTime?
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, provider, status, retryEligibleAt])
  @@map("portal_operations")
}

/// Immutable external enquiry history. A retry is idempotent by provider +
/// external event/lead id; ambiguous people remain reviewable rather than
/// being silently merged.
model ExternalLeadEvent {
  id                String                    @id @default(cuid())
  organizationId    String                    @default("org_default")
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId      String?
  connection        PropertyPortalConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  portalListingId   String?
  portalListing     PortalListing?            @relation(fields: [portalListingId], references: [id], onDelete: SetNull)
  leadId            String?
  lead              Lead?                     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  provider          PropertyPortalProvider
  externalLeadId    String?
  externalEventId   String?
  externalListingId String?
  receivedAt        DateTime                  @default(now())
  message           String?
  /// Safe, staff-facing summary (name/phone/email/project/locality/budget/area) captured at
  /// ingestion time so the review UI can show contact and requirement context even before
  /// (or without ever) linking to a Lead. Never the full raw provider payload.
  leadSnapshot      String?
  rawPayloadHash    String
  ingestionStatus   PortalIngestionStatus     @default(NEW)
  failureReason     String?
  attemptCount      Int                       @default(0)
  lastAttemptAt     DateTime?
  resolvedAt        DateTime?
  resolvedById      String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([organizationId, provider, externalEventId])
  @@index([organizationId, provider, externalLeadId])
  @@index([organizationId, ingestionStatus, receivedAt])
  @@map("external_lead_events")
}

model LeadScoreHistory {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  score          Int
  priority       LeadPriority
  factors        String // JSON array of {label, delta, reason}
  trigger        String // e.g. "LEAD_CREATED", "STATUS_CHANGED", "VISIT_SCHEDULED"
  createdAt      DateTime     @default(now())

  @@map("lead_score_history")
}

model LeadTransfer {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromUserId     String?
  fromUser       User?        @relation("TransferFrom", fields: [fromUserId], references: [id])
  toUserId       String
  toUser         User         @relation("TransferTo", fields: [toUserId], references: [id])
  reason         String?
  createdAt      DateTime     @default(now())

  @@map("lead_transfers")
}

// ---------------------------------------------------------------------------
// WhatsApp Sharing
// ---------------------------------------------------------------------------

model SharedPropertyLog {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyIds    String // JSON array of property ids included in this share
  message        String
  sharedById     String?
  sharedBy       User?        @relation("SharedBy", fields: [sharedById], references: [id])
  whatsappLink   String
  createdAt      DateTime     @default(now())

  Property   Property? @relation(fields: [propertyId], references: [id])
  propertyId String?

  @@map("shared_property_logs")
}

// ---------------------------------------------------------------------------
// Visits
// ---------------------------------------------------------------------------

model Visit {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation("AssignedFieldExecutive", fields: [assignedToId], references: [id])

  visitDate       DateTime
  visitTime       String
  meetingLocation String?
  status          VisitStatus   @default(SCHEDULED)
  clientFeedback  String?
  employeeNotes   String?
  outcome         VisitOutcome?
  followUpAction  String?

  // Maps & Localities phase - route/conflict metadata. Populated only when
  // conflict detection actually runs (on schedule/update); never guessed.
  travelDurationMinutes    Int?
  travelDistanceMeters     Int?
  routeCheckedAt           DateTime?
  routeSource              RouteSource         @default(NONE)
  conflictStatus           VisitConflictStatus @default(NONE)
  conflictDetail           String? // short, non-sensitive description (e.g. "18 min travel needed, only 10 min available") - never a full address dump
  conflictOverrideReason   String?
  conflictOverrideByUserId String?
  conflictOverrideBy       User?               @relation("VisitConflictOverrideBy", fields: [conflictOverrideByUserId], references: [id])
  conflictOverrideAt       DateTime?

  // Catalogue -> Visit workflow.
  //
  // `propertyId` above stays REQUIRED and keeps its original meaning for
  // every pre-existing single-property visit. For a multi-property visit it
  // holds the FIRST selected property, so all legacy readers
  // (visit.property.title, checkVisitConflict, suggested-route, reports)
  // keep working untouched. The authoritative property set is `properties`
  // below; the migration backfills exactly one VisitProperty row per existing
  // visit so old and new readers agree from the moment it is applied.
  catalogueShareId String?
  catalogueShare   CatalogueShare? @relation(fields: [catalogueShareId], references: [id])
  createdById      String?
  createdBy        User?           @relation("VisitCreatedBy", fields: [createdById], references: [id])

  startedAt   DateTime?
  completedAt DateTime?
  /// Overall client interest captured on [Complete Visit], 1-5. Raw star value
  /// is the source of truth; any LOW_INTEREST/MAYBE/INTERESTED/HIGHLY_INTERESTED
  /// label is derived for display only (see src/lib/visits.ts).
  overallRating      Int?
  completionSummary  String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedback            VisitFeedback?
  availabilityReports PropertyAvailabilityReport[]
  properties          VisitProperty[]
  /// The client-side catalogue visit request(s) this visit was confirmed from.
  /// Empty for a visit an Admin created directly rather than from a request.
  requestInteractions CatalogueInteraction[] @relation("VisitFromCatalogueRequest")

  @@index([organizationId, visitDate])
  @@index([organizationId, assignedToId, visitDate])
  @@map("visits")
}

/// One property inside one visit. Created for every visit (including
/// single-property ones) so there is exactly one code path for progress.
model VisitProperty {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id])
  visitId        String
  visit          Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])

  sequence Int                 @default(0)
  status   VisitPropertyStatus @default(PENDING)

  visitedAt   DateTime?
  visitedById String?
  visitedBy   User?     @relation("VisitPropertyVisitedBy", fields: [visitedById], references: [id])

  /// Client reaction to THIS property, 1-5 stars. Structured integer, not a
  /// decorative UI value - reporting reads it directly.
  reactionRating Int?
  reactionNote   String?
  /// Optional, only meaningful for SKIPPED/UNAVAILABLE.
  skipReason String?
  /// Post-visit shortlist. Kept here rather than in a second shortlist system;
  /// CatalogueShareProperty.executiveStatus = SHORTLISTED is mirrored when the
  /// visit came from a catalogue, so the existing catalogue shortlist stays
  /// the single client-facing source of truth.
  isPreferred Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([visitId, propertyId])
  @@index([organizationId, propertyId])
  @@index([visitId, sequence])
  @@map("visit_properties")
}

// ---------------------------------------------------------------------------
// Follow-ups
// ---------------------------------------------------------------------------

model FollowUp {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  crmOwnerId     String?
  crmOwner       Owner?       @relation(fields: [crmOwnerId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?        @relation("FollowUpOwner", fields: [ownerId], references: [id])

  type        FollowUpType
  dueDate     DateTime
  notes       String?
  status      FollowUpStatus @default(PENDING)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("follow_ups")
}

// ---------------------------------------------------------------------------
// Activity Timeline
// ---------------------------------------------------------------------------

model Activity {
  id                 String            @id @default(cuid())
  organizationId     String            @default("org_default")
  organization       Organization      @relation(fields: [organizationId], references: [id])
  leadId             String?
  lead               Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  crmOwnerId         String?
  crmOwner           Owner?            @relation(fields: [crmOwnerId], references: [id], onDelete: Cascade)
  dealId             String?
  deal               Deal?             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  inventoryPartnerId String? // Phase 4 - Field Operations
  inventoryPartner   InventoryPartner? @relation(fields: [inventoryPartnerId], references: [id], onDelete: Cascade)
  actorId            String?
  actor              User?             @relation("ActivityActor", fields: [actorId], references: [id])
  type               ActivityType
  description        String
  metadata           String? // JSON blob for extra context
  createdAt          DateTime          @default(now())

  @@index([crmOwnerId])
  @@index([dealId])
  @@index([inventoryPartnerId])
  // Serves GET /api/activities and dashboard-data.ts's recentActivities,
  // both now organizationId-scoped (see org-isolation audit) - previously
  // no index covered organizationId on this table at all.
  @@index([organizationId, createdAt])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// WhatsApp conversations + messages (Phase 2B)
//
// Provider-agnostic: MOCK and CLICK_TO_CHAT need no credentials and are the
// default locally; META_CLOUD is structurally complete but inert without
// real Meta credentials (see src/integrations/whatsapp/). SharedPropertyLog
// (Phase 1) remains the lightweight historical record on the lead's "Shared"
// tab; CatalogueShare below is the newer, richer, publicly-trackable
// equivalent - creating a catalogue also writes a SharedPropertyLog row so
// both stay in sync and no history is lost. See README "WhatsApp & Catalogue
// Sharing" section for the full relationship writeup.
// ---------------------------------------------------------------------------

model WhatsAppConversation {
  id                    String                     @id @default(cuid())
  organizationId        String                     @default("org_default")
  organization          Organization               @relation(fields: [organizationId], references: [id])
  leadId                String?
  lead                  Lead?                      @relation(fields: [leadId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignedToId          String?
  assignedTo            User?                      @relation("WhatsAppConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  phoneNumber           String
  displayName           String?
  contactState          WhatsAppContactState       @default(UNKNOWN)
  provider              WhatsAppProviderName
  providerPhoneNumberId String?
  providerMetadata      String?
  status                WhatsAppConversationStatus @default(OPEN)
  unreadCount           Int                        @default(0)
  crmReadAt             DateTime?
  lastMessageAt         DateTime?
  lastInboundAt         DateTime?
  lastOutboundAt        DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  messages        WhatsAppMessage[]
  catalogueShares CatalogueShare[]

  @@unique([leadId, phoneNumber])
  @@index([organizationId, status])
  @@index([organizationId, phoneNumber])
  @@index([organizationId, assignedToId, lastMessageAt])
  @@index([organizationId, unreadCount, lastMessageAt])
