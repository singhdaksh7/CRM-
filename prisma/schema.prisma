  status          ImportStatus        @default(PENDING)
  importMode      InventoryImportMode @default(CREATE_ONLY)
  partialPolicy   ImportPartialPolicy @default(REQUIRE_ALL_ROWS_VALID)
  allowBlankClear Boolean             @default(false)
  fileHash        String?

  totalRows     Int @default(0)
  validRows     Int @default(0)
  invalidRows   Int @default(0)
  importedRows  Int @default(0)
  duplicateRows Int @default(0)
  warningRows   Int @default(0)
  errorRows     Int @default(0)
  createdRows   Int @default(0)
  updatedRows   Int @default(0)
  skippedRows   Int @default(0)
  failedRows    Int @default(0)

  columnMapping String // JSON: { targetField: sourceColumn }
  errorLog      String? // JSON array of { row, error }

  createdById  String?
  createdBy    User?     @relation("ImportJobCreatedBy", fields: [createdById], references: [id])
