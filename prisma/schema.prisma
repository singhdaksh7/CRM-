// ---------------------------------------------------------------------------
// Backup foundation (Phase 1, Module 9) - metadata + restore validation only,
// no automated backup execution is implemented here.
// ---------------------------------------------------------------------------

model BackupRecord {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           BackupType   @default(FULL)
  status         BackupStatus @default(PENDING)

  triggeredById String?
  triggeredBy   User?     @relation("BackupTriggeredBy", fields: [triggeredById], references: [id])
  startedAt     DateTime?
  completedAt   DateTime?
  sizeBytes     Int?
  location      String?
  checksum      String?
  errorMessage  String?
  createdAt     DateTime  @default(now())

  restoreValidations RestoreValidation[]

  @@index([organizationId, status])
  @@map("backup_records")
}

model RestoreValidation {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id])
  backupRecordId String
  backupRecord   BackupRecord @relation(fields: [backupRecordId], references: [id], onDelete: Cascade)
  status         BackupStatus @default(PENDING)

  validatedById String?
  validatedBy   User?     @relation("RestoreValidatedBy", fields: [validatedById], references: [id])
  validatedAt   DateTime?
  issuesFound   String? // JSON array of strings

  createdAt DateTime @default(now())

  @@map("restore_validations")
}

// ---------------------------------------------------------------------------
// Saved Views (Phase 2 - Smart Search & Productivity)
// ---------------------------------------------------------------------------

enum SavedViewEntityType {
  LEAD
  PROPERTY
  CONTACT
  REQUIREMENT
}

/**
 * A user's saved filter preset for the Leads or Properties list page.
 * `filters` is a JSON object of plain string key/value pairs mirroring the
 * page's own URL query params (e.g. {"status":"HOT","area":"Rajouri
 * Garden"}) - never executable code, never a raw SQL/Prisma fragment.
 */
model SavedView {
  id             String              @id @default(cuid())
  organizationId String              @default("org_default")
  organization   Organization        @relation(fields: [organizationId], references: [id])
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType     SavedViewEntityType
  name           String
  filters        String // JSON object of string key/value filter params
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([userId, entityType, name])
  @@index([organizationId, userId, entityType])
  @@map("saved_views")
}

// ---------------------------------------------------------------------------
// System Configuration (Phase 3, Module 7)
//
// Singleton-per-organization row holding previously-hardcoded business rules
// (hot lead threshold, health score weights, matching radius/budget %,
// follow-up SLA, visit reminder timing, notification timing, catalogue
// expiry, business hours). `values` is a JSON blob merged over
// DEFAULT_SYSTEM_CONFIG (src/lib/system-config.ts) at read time, so adding a
// new configurable key never requires a migration.
// ---------------------------------------------------------------------------

model SystemConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id])
  values         String       @default("{}") // JSON blob, shape: Partial<SystemConfigValues>
  updatedById    String?
  updatedBy      User?        @relation(fields: [updatedById], references: [id])
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  @@map("system_configs")
}

// ---------------------------------------------------------------------------
// Automation Rules Engine (Phase 3, Module 8)
//
// Admin-configurable "when X happens, do Y" rules. Deliberately small and
// deterministic (no arbitrary code execution) - each rule pairs one trigger
// with one action type plus a JSON actionConfig. Executed best-effort and
// non-blocking from the existing trigger points (lead creation, visit
// completion, catalogue view, payment received); failures are logged via the
// existing audit log, never surfaced to the end user as an error.
// ---------------------------------------------------------------------------

model AutomationRule {
  id             String               @id @default(cuid())
  organizationId String               @default("org_default")
  organization   Organization         @relation(fields: [organizationId], references: [id])
  name           String
  trigger        AutomationTrigger
  actionType     AutomationActionType
  actionConfig   String               @default("{}") // JSON blob, shape depends on actionType
  isActive       Boolean              @default(false)
  createdById    String?
  createdBy      User?                @relation(fields: [createdById], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId, trigger, isActive])
  @@map("automation_rules")
}

// ---------------------------------------------------------------------------
// Phase 4 - Field Operations & Property Workflow
// ---------------------------------------------------------------------------

// Not every property comes through a broker in Delhi - could be another
// company, a dealer, a builder, or a society office. "Inventory Partner" is
// deliberately generic. One partner owns many indirect properties; details
// are never duplicated onto each Property row (see Property.partnerId).
model InventoryPartner {
  id                    String       @id @default(cuid())
  organizationId        String       @default("org_default")
  organization          Organization @relation(fields: [organizationId], references: [id])
  partnerCode           String       @unique
  name                  String
  company               String?
  phone                 String
  alternatePhone        String?
  localities            String       @default("[]") // JSON array of strings, same convention as Property.amenities
  notes                 String?
  commissionSplitPct    Float?
  isActive              Boolean      @default(true)
  lastInventoryUpdateAt DateTime?

  createdById String?
  createdBy   User?    @relation("InventoryPartnerCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties                     Property[]
  notifications                  Notification[]
  activities                     Activity[]
  requirementBroadcastRecipients RequirementBroadcastRecipient[]

  @@index([organizationId, isActive])
  @@index([organizationId, phone])
  @@map("inventory_partners")
}

// Append-only complete property history: status changes, catalogue
// sends/views, visits, price/rent updates, verification events. Nothing is
// ever updated or deleted from this table - see appendPropertyTimelineEvent.
model PropertyTimelineEvent {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  eventType      String // free-text label, not an enum, so new event labels never need a migration
  fromValue      String?
  toValue        String?
  note           String?
  actorId        String?
  actor          User?        @relation("PropertyTimelineEventActor", fields: [actorId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, propertyId, createdAt])
  @@map("property_timeline_events")
}

enum AvailabilityReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AvailabilityReportReason {
  ALREADY_RENTED
  ALREADY_SOLD
  PROPERTY_LOCKED
  OWNER_UNREACHABLE
  OTHER
}

// Executive-reported "this property may not actually be available" flow.
// photoId is required (not just documented as required) - the review route
// rejects creation without a real PropertyImage of purpose
// AVAILABILITY_REPORT, to prevent fake/lazy reports.
model PropertyAvailabilityReport {
  id             String                   @id @default(cuid())
  organizationId String                   @default("org_default")
  organization   Organization             @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  visitId        String?
  visit          Visit?                   @relation(fields: [visitId], references: [id])
  reportedById   String
  reportedBy     User                     @relation("AvailabilityReportedBy", fields: [reportedById], references: [id])
  reason         AvailabilityReportReason
  note           String?
  photoId        String
  photo          PropertyImage            @relation(fields: [photoId], references: [id])
  status         AvailabilityReportStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?                    @relation("AvailabilityReportReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([propertyId])
  @@map("property_availability_reports")
}

enum PropertyReportType {
  WRONG_RENT
  WRONG_PHOTOS
  WRONG_AREA
  OWNER_NOT_RESPONDING
  DUPLICATE_LISTING
  PROPERTY_CLOSED
  ALREADY_RENTED
  ALREADY_SOLD
  NEEDS_NEW_PHOTOS
  REQUIRES_VERIFICATION
}

enum PropertyReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// General data-quality reporting queue - distinct from
// PropertyAvailabilityReport because its resolve semantics don't drive an
// automatic inventory status change. Both feed the unified "Property Issues
// Queue" admin view (GET /api/admin/property-issues merges both).
model PropertyReport {
  id             String               @id @default(cuid())
  organizationId String               @default("org_default")
  organization   Organization         @relation(fields: [organizationId], references: [id])
  propertyId     String
  property       Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reportedById   String
  reportedBy     User                 @relation("PropertyReportedBy", fields: [reportedById], references: [id])
  type           PropertyReportType
  note           String?
  status         PropertyReportStatus @default(PENDING)
  resolvedById   String?
  resolvedBy     User?                @relation("PropertyReportResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([propertyId])
  @@map("property_reports")
}

// One structured feedback record per visit, submitted/edited by the
// executive after the visit. Feeds Lead Health and Property Health.
model VisitFeedback {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id])
  visitId        String       @unique
  visit          Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)

  customerLiked       String? // JSON array of strings
  customerDisliked    String? // JSON array of strings
  budgetIssue         Boolean @default(false)
  areaIssue           Boolean @default(false)
  parkingIssue        Boolean @default(false)
  familyRejected      Boolean @default(false)
  ownerRejected       Boolean @default(false)
  willVisitAgain      Boolean @default(false)
  negotiationRequired Boolean @default(false)
  additionalNotes     String?

  submittedById String
  submittedBy   User     @relation("VisitFeedbackSubmittedBy", fields: [submittedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("visit_feedback")
}

// Closes a documented gap: only /transfer wrote assignment history before
// Phase 4 (via LeadTransfer, kept exactly as-is). This table is written from
// all four assignment code paths (assign, auto-assign, bulk-auto-assign,
// transfer) so every assignment - not just re-assignments - is auditable.
model LeadAssignmentHistory {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  toUserId       String
  toUser         User         @relation("AssignmentHistoryTo", fields: [toUserId], references: [id])
  method         String // "MANUAL_ASSIGN" | "AUTO_ASSIGN" | "BULK_AUTO_ASSIGN" | "TRANSFER"
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, leadId, createdAt])
  @@map("lead_assignment_history")
}

// Append-only log of catalogue version changes (property removed/added
// after a catalogue was already sent). The token/link never changes -
// clients always see the current active property set, this log exists
// purely for transparency/audit.
model CatalogueVersionEvent {
  id               String         @id @default(cuid())
  organizationId   String         @default("org_default")
  organization     Organization   @relation(fields: [organizationId], references: [id])
  catalogueShareId String
  catalogueShare   CatalogueShare @relation(fields: [catalogueShareId], references: [id], onDelete: Cascade)
  version          Int
  changeType       String // "PROPERTY_REMOVED" | "PROPERTY_ADDED"
  propertyId       String?
  reason           String?
  actorId          String?
  actor            User?          @relation("CatalogueVersionEventActor", fields: [actorId], references: [id])
  createdAt        DateTime       @default(now())

  @@index([catalogueShareId, version])
  @@map("catalogue_version_events")
}

model PropertyFavorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@map("property_favorites")
}

// Written (fire-and-forget) on every internal-property-view read. Reads are
// always limited + de-duplicated by propertyId in application code - never
// an unbounded scan.
model PropertyViewLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  viewedAt   DateTime @default(now())

  @@index([userId, viewedAt])
  @@map("property_view_logs")
}

// ---------------------------------------------------------------------------
// Demand Pool + Customer Requirements + Two-Way Matching
// ---------------------------------------------------------------------------

enum ContactStatus {
  ACTIVE
  INACTIVE
  DO_NOT_CONTACT
  ARCHIVED
}

/// Long-term customer/prospect demand pool, distinct from the active Lead
/// pipeline: KP's ~5,000+ historical customer database should not be forced
/// into Lead just to remain matchable against new inventory. A contact can
/// later be linked to / converted into a Lead without duplicating identity
/// - see Lead.customerContactId and CustomerRequirement.convertedLeadId.
model CustomerContact {
  id                 String        @id @default(cuid())
  organizationId     String        @default("org_default")
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  phone              String
  // Dedupe key: normalizeIndianPhone(phone). Unique per org so a re-import
  // or manual re-entry of the same person reuses the existing Contact
  // instead of creating a duplicate identity.
  normalizedPhone    String
  email              String?
  source             LeadSource    @default(MANUAL)
  notes              String?
  tags               String        @default("[]") // JSON string array
  status             ContactStatus @default(ACTIVE)
  doNotContact       Boolean       @default(false)
  whatsAppOptOut     Boolean       @default(false)
  lastContactedAt    DateTime?
  lastPropertySentAt DateTime?
  createdById        String?
  createdBy          User?         @relation("CustomerContactCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  requirements    CustomerRequirement[]
  recommendations PropertyRecommendation[]
  leads           Lead[]                   @relation("LeadCustomerContact")

  @@unique([organizationId, normalizedPhone])
  @@index([organizationId, status])
  @@index([organizationId, email])
  @@map("customer_contacts")
}

enum CustomerRequirementPriority {
  LOW
  MEDIUM
  HIGH
}

/// A single reusable requirement belonging to a CustomerContact. One contact
/// may hold multiple active requirements at once (e.g. a residential rent
/// need and a separate commercial sale need). Deliberately reuses the same
/// AssetClass/TransactionType/PropertyType/CommercialFitOut enums as
/// Property/Lead rather than declaring parallel ones, so the matching engine
/// never has to translate between two enum universes. Commercial
/// requirements never depend on `bhk` (left null), matching the same
/// convention already established on Property/Lead.
model CustomerRequirement {
  id                     String               @id @default(cuid())
  organizationId         String               @default("org_default")
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerContactId      String
  customerContact        CustomerContact      @relation(fields: [customerContactId], references: [id], onDelete: Cascade)

  assetClass             AssetClass           @default(RESIDENTIAL)
  transactionType        TransactionType      @default(RENT)
  propertyType           PropertyType?
  commercialPropertyType PropertyType?
  // JSON string array of locality names - mirrors Lead.preferredLocation
  // being a single string, but a requirement may legitimately span more
  // than one acceptable locality.
  preferredLocalities    String               @default("[]")
  minBudget              Int?
  maxBudget              Int?
  minArea                Int?
  maxArea                Int?
  bhk                    Int?
  floorPreference        String?
  furnishing             FurnishingStatus?
  parkingRequired        Boolean?
  liftRequired           Boolean?
  commercialFitOutPref   CommercialFitOut?
  workstations           Int?
  cabins                 Int?
  possession             String?
  notes                  String?
  active                 Boolean              @default(true)
  priority               CustomerRequirementPriority @default(MEDIUM)
  // Bumped by [Mark Requirement Confirmed]; a requirement older than
  // SystemConfig.requirementStaleAfterDays is excluded from automatic
  // matching (still searchable) until re-confirmed. See REQUIREMENT_EXPIRY.
  lastConfirmedAt        DateTime             @default(now())
  createdById            String?
  createdBy              User?                @relation("CustomerRequirementCreatedBy", fields: [createdById], references: [id])
  // 1:1 - set once this requirement was used to create a Lead via
  // [Create Lead from Requirement]; prevents creating a second Lead from the
  // same requirement.
  convertedLeadId        String?              @unique
  convertedLead          Lead?                @relation("LeadFromRequirement", fields: [convertedLeadId], references: [id])
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  recommendations PropertyRecommendation[]

  @@index([organizationId, active, assetClass, transactionType])
  @@index([customerContactId])
  @@map("customer_requirements")
}

enum RecommendationTier {
  EXACT
  STRONG
  STRETCH
  LOW
}

enum RecommendationStatus {
  PENDING
  REVIEWED
  IGNORED
  PREPARED
  SENT
  RESPONDED
  EXPIRED
}

enum DemandCandidateSource {
  CONTACT
  LEAD
}

enum CustomerResponseOutcome {
  INTERESTED
  NOT_INTERESTED
  VISIT_REQUESTED
  BUDGET_TOO_HIGH
  LOCATION_NOT_SUITABLE
  ALREADY_PURCHASED
  DO_NOT_CONTACT
}

/// Property -> demand match record, produced by the two-way matching engine
/// (src/lib/demand-matching.ts) for both directions (a Property's matched
/// customers, and a CustomerRequirement's matching properties are both just
/// queries over this same table). Exactly one of customerContactId / leadId
/// is set, mirrored by `source`, so CONTACT-pool and LEAD-pool candidates
/// normalize into one unified list.
///
/// `candidateKey` (`CONTACT:<id>` or `LEAD:<id>`) exists purely so the
/// unique index below actually enforces idempotency: Postgres treats two
/// NULLs as distinct in a composite unique constraint, so uniquing directly
/// on the nullable (customerContactId, leadId) pair would silently allow
/// duplicate rows for the LEAD-sourced half of the table.
///
/// Nothing in this model is ever set to SENT by a background job or an
/// automatic recompute - see ZERO AUTO-SEND. PREPARED/SENT only ever result
/// from an explicit user action in the API layer.
model PropertyRecommendation {
  id             String       @id @default(cuid())
  organizationId String       @default("org_default")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  source            DemandCandidateSource
  candidateKey      String
  customerContactId String?
  customerContact   CustomerContact?     @relation(fields: [customerContactId], references: [id], onDelete: Cascade)
  leadId            String?
  lead              Lead?                @relation("PropertyRecommendationLead", fields: [leadId], references: [id], onDelete: Cascade)
  requirementId     String?
  requirement       CustomerRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  tier    RecommendationTier
  score   Int
  reasons String             @default("[]") // JSON string array of human-readable explanation lines
  status  RecommendationStatus @default(PENDING)

  preparedAt        DateTime?
  sentAt             DateTime?
  channel            String? // e.g. "WHATSAPP_CLICK_TO_CHAT", "WHATSAPP_META"
  providerMessageId  String?
  createdById        String?
  createdBy          User?    @relation("PropertyRecommendationCreatedBy", fields: [createdById], references: [id])

  responseOutcome CustomerResponseOutcome?
  respondedAt     DateTime?
  respondedById   String?
  respondedBy     User?     @relation("PropertyRecommendationRespondedBy", fields: [respondedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, propertyId, candidateKey])
  @@index([organizationId, propertyId, tier])
  @@index([organizationId, customerContactId])
  @@index([organizationId, leadId])
  @@index([organizationId, status])
  @@map("property_recommendations")
}
