# Database - PostgreSQL. DATABASE_URL is the runtime connection used by the
# app (Supabase Transaction Pooler, port 6543, with pgbouncer=true since
# Prisma's prepared statements are incompatible with transaction-mode
# pooling). connection_limit and pool_timeout size the Prisma-side pool -
# too low a connection_limit causes P2024 pool-timeout errors under
# concurrent requests (e.g. the dashboard's grouped queries); see
# src/lib/dashboard-data.ts for how per-request query concurrency is also
# capped so a single request can't starve the pool by itself.
# DIRECT_URL is used only for Prisma migrations/introspection/Studio
# (Supabase Session Pooler or direct connection, port 5432) - never widen
# its pool, it isn't used for concurrent runtime traffic.
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20&sslmode=require"
DIRECT_URL="postgresql://user:pass@host:5432/postgres?sslmode=require"

# NextAuth
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Authorizes POST /api/internal/notifications/sweep - the due/overdue
# follow-up notification sweep, run on a schedule (see vercel.json's
# `crons`) instead of blocking every page navigation. Vercel Cron sends
# `Authorization: Bearer $CRON_SECRET` automatically once both this env var
# and a `crons` entry are configured. Generate with `openssl rand -hex 32`.
CRON_SECRET=""

# Public app URL - used to build public catalogue links (/share/catalogue/[token])
# and property links embedded in WhatsApp messages.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Legacy quick-share flow (Phase 1, /leads/[id]/match) ---------------
# Independent of the WhatsApp provider architecture below (shares the same
# WHATSAPP_PHONE_NUMBER_ID declared there). See README.
NEXT_PUBLIC_WHATSAPP_BUSINESS_NAME="Delhi Broker CRM"
WHATSAPP_API_MODE="mock"
WHATSAPP_CLOUD_API_TOKEN=""

# --- WhatsApp provider architecture (Phase 2B) ---------------------------
# Conversations + Catalogue sharing. One of: MOCK | CLICK_TO_CHAT | META_CLOUD.
# Defaults to MOCK locally - no credentials required. See README "WhatsApp
# Provider Architecture" section for what each provider does and how to
# switch to the real WhatsApp Business Cloud API.
WHATSAPP_PROVIDER="MOCK"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v20.0"

# Future: 99acres / Magicbricks official API credentials. When set, the
# corresponding /api/integrations/leads/* webhook requires this exact value
# in the `x-api-key` request header. Leave empty only for local/mock testing
# - an empty value leaves that webhook route unauthenticated.
ACRES_99_API_KEY=""
MAGICBRICKS_API_KEY=""

# --- Document storage (Module 5 - Phase 2J) -------------------------------
# Not yet wired to a provider. Document.fileUrl currently expects a URL the
# caller already uploaded to durable storage. Set these once a provider is
# provisioned (see DEPLOYMENT.md "File Storage"); until then leave blank -
# /api/system/status will correctly report storage as "not_configured".
STORAGE_PROVIDER=""            # e.g. "s3"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Production Admin bootstrap (scripts/bootstrap-admin.ts) --------------
# Run once via `npm run bootstrap:production` against the target database.
# Never run `npm run db:seed` (demo data + predictable passwords) in
# production. Safe to run this repeatedly - it creates the default
# organization only if missing and exactly one Admin only if none exists yet;
# it never overwrites an existing Admin. Leave blank except when actually
# running the bootstrap; do not commit real values here.
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""          # 12+ chars, upper+lower+digit+symbol
BOOTSTRAP_ORGANIZATION_NAME=""       # optional, defaults to "Delhi Broker CRM"

# --- Email (optional) ------------------------------------------------------
# Not currently used by any code path. Set if/when a notification-by-email
# feature is added; /api/system/status reports "not_configured" without it.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
