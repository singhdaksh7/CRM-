# Database - PostgreSQL. DATABASE_URL is the runtime connection used by the
# app (Supabase Transaction Pooler, port 6543, with pgbouncer=true since
# Prisma's prepared statements are incompatible with transaction-mode
# pooling). connection_limit and pool_timeout size the Prisma-side pool -
# too low a connection_limit causes P2024 pool-timeout errors under
# concurrent requests (e.g. the dashboard's grouped queries); see
# src/lib/dashboard-data.ts for how per-request query concurrency is also
# capped so a single request can't starve the pool by itself.
# DIRECT_URL is used only for Prisma migrations/introspection/Studio
# (Supabase Session Pooler or direct connection, port 5432) - never widen
# its pool, it isn't used for concurrent runtime traffic.
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20&sslmode=require"
DIRECT_URL="postgresql://user:pass@host:5432/postgres?sslmode=require"

# NextAuth
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Authorizes POST /api/internal/notifications/sweep - the due/overdue
# follow-up notification sweep, run on a schedule (see vercel.json's
# `crons`) instead of blocking every page navigation. Vercel Cron sends
# `Authorization: Bearer $CRON_SECRET` automatically once both this env var
# and a `crons` entry are configured. Generate with `openssl rand -hex 32`.
CRON_SECRET=""

# Public app URL - used to build public catalogue links (/share/catalogue/[token])
# and property links embedded in WhatsApp messages.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Legacy quick-share flow (Phase 1, /leads/[id]/match) ---------------
# Independent of the WhatsApp provider architecture below (shares the same
# WHATSAPP_PHONE_NUMBER_ID declared there). See README.
NEXT_PUBLIC_WHATSAPP_BUSINESS_NAME="Delhi Broker CRM"
WHATSAPP_API_MODE="mock"
WHATSAPP_CLOUD_API_TOKEN=""

# --- WhatsApp provider architecture (Phase 2B, production-hardened) ------
# Conversations + Catalogue sharing. One of: MOCK | CLICK_TO_CHAT | META_CLOUD.
# Defaults to MOCK locally - no credentials required. See WHATSAPP_SETUP.md
# for the full Meta dashboard walkthrough and what each provider does.
WHATSAPP_PROVIDER="MOCK"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
# Required (with the five above) when WHATSAPP_PROVIDER=META_CLOUD - gates
# webhook signature verification. Never commit a real value.
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v20.0"
# Prefix applied to a bare 10-digit local mobile number (phone.ts).
WHATSAPP_DEFAULT_COUNTRY_CODE="91"
# Only used by the Admin-only "Send Test Message" diagnostic action in
# Settings - never for any automatic/bulk send. Leave empty until needed.
WHATSAPP_TEST_RECIPIENT=""
# Set to "false" to take the webhook endpoint offline (503) even while
# META_CLOUD is selected - useful mid-setup, before Meta's webhook
# subscription is actually configured. Defaults to enabled.
WHATSAPP_WEBHOOK_ENABLED="true"
# Comma-separated exact Meta template names confirmed "Approved" in Meta
# Business Manager. A template not listed here is refused with a clear
# config error rather than silently sent or falling back to free text -
# see whatsapp-templates.ts. Empty by default (nothing approved without a
# real Meta account to check against).
WHATSAPP_APPROVED_TEMPLATE_NAMES=""

# Future: 99acres / Magicbricks official API credentials. When set, the
# corresponding /api/integrations/leads/* webhook requires this exact value
# in the `x-api-key` request header. Leave empty only for local/mock testing
# - an empty value leaves that webhook route unauthenticated.
ACRES_99_API_KEY=""
MAGICBRICKS_API_KEY=""

# --- Document storage (Document Vault + property images) -------------------
# STORAGE_PROVIDER selects which lib/storage-providers/* backs uploads:
#   DISABLED (default) - no provider configured. Upload endpoints return a
#     clear 503 "not configured"; every other CRM page keeps working, and
#     Document.fileUrl (a pre-uploaded external URL) still works standalone.
#   R2       - Cloudflare R2 (S3-compatible, preferred production provider).
#     Requires R2_ACCOUNT_ID (or R2_ENDPOINT), R2_ACCESS_KEY_ID,
#     R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME below. See DEPLOYMENT.md
#     "2.5 Cloudflare R2 storage provider" for bucket creation and API token
#     steps.
#   S3       - AWS S3 or any other S3-compatible host (MinIO, Backblaze B2).
#     Requires STORAGE_BUCKET/STORAGE_ACCESS_KEY_ID/STORAGE_SECRET_ACCESS_KEY.
#   FIREBASE - Firebase Storage via the Admin SDK, server-mediated upload
#     (see DEPLOYMENT.md "2.4 Firebase Storage provider"). Optional fallback
#     only - never activated in this deployment (billing was not completed).
#     Requires the FIREBASE_* variables below.
STORAGE_PROVIDER="DISABLED"

# Cloudflare R2 (used when STORAGE_PROVIDER=R2) - server-only, never prefix
# with NEXT_PUBLIC_. Region is always "auto" (not configurable - R2 has no
# AWS-style regions). Endpoint is derived as
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com unless R2_ENDPOINT is set
# explicitly. Never commit real values here.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
R2_SIGNED_URL_EXPIRY_SECONDS="300"
# Only set this if serving already-public, catalogue-safe assets from a
# custom domain later - never used for presigning (R2 presigned URLs must
# use the R2_ENDPOINT S3 API hostname). Leave empty while the bucket is
# private (the default and current pilot configuration).
R2_PUBLIC_BASE_URL=""

# S3 (used when STORAGE_PROVIDER=S3)
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Firebase Admin SDK (used when STORAGE_PROVIDER=FIREBASE) - server-only,
# never prefix these with NEXT_PUBLIC_. From the service-account JSON
# downloaded in Firebase Console > Project Settings > Service Accounts >
# Generate new private key - delete that JSON file after copying these out.
# FIREBASE_PRIVATE_KEY: paste with literal \n sequences intact (Vercel's env
# var UI stores multi-line PEM keys this way); src/lib/firebase-admin.ts
# un-escapes them automatically.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# --- Maps, Localities & Visit Routing ---------------------------------------
# MAPS_PROVIDER selects the geocoding/directions provider (src/integrations/maps/).
# Defaults to DISABLED - address search/map panels show a clear "not
# configured" state; manual address entry, property forms, visit scheduling,
# and external "Open in Google Maps"/directions/call/WhatsApp links all keep
# working with zero configuration. See GOOGLE_MAPS_SETUP.md.
MAPS_PROVIDER="DISABLED"

# Server-only - never prefix with NEXT_PUBLIC_. Required when MAPS_PROVIDER=GOOGLE.
# Restrict this key (Google Cloud Console) to Geocoding/Places/Directions/
# Distance Matrix APIs only - never give it an HTTP-referrer restriction.
GOOGLE_MAPS_SERVER_API_KEY=""

# Intentionally public (used by the browser for the map preview embed) -
# MUST be restricted to this app's domain in the Google Cloud Console
# (HTTP referrers), never left unrestricted. Leave empty to disable the
# embedded map preview even while MAPS_PROVIDER=GOOGLE (external "Open in
# Google Maps" links still work either way).
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=""

# Optional - only needed for Advanced Markers on a future interactive JS map.
GOOGLE_MAPS_MAP_ID=""
GOOGLE_MAPS_DEFAULT_REGION="IN"
GOOGLE_MAPS_DEFAULT_LANGUAGE="en"
GOOGLE_MAPS_DEFAULT_CITY="Delhi"

# --- Production Admin bootstrap (scripts/bootstrap-admin.ts) --------------
# Run once via `npm run bootstrap:production` against the target database.
# Never run `npm run db:seed` (demo data + predictable passwords) in
# production. Safe to run this repeatedly - it creates the default
# organization only if missing and exactly one Admin only if none exists yet;
# it never overwrites an existing Admin. Leave blank except when actually
# running the bootstrap; do not commit real values here.
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""          # 12+ chars, upper+lower+digit+symbol
BOOTSTRAP_ORGANIZATION_NAME=""       # optional, defaults to "Delhi Broker CRM"

# --- Email (optional) ------------------------------------------------------
# Not currently used by any code path. Set if/when a notification-by-email
# feature is added; /api/system/status reports "not_configured" without it.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""
