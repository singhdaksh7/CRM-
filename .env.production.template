# ==============================================================================
# KP PROPERTIES CRM - HOSTINGER VPS PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to `.env.production` on the VPS:
#   cp .env.production.template .env.production
#   chmod 600 .env.production
# Populate real values on the VPS only. NEVER commit secrets to git.
# ==============================================================================

# --- Node & Core Runtime ---
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# --- Traefik & Domain Routing (Hostinger Host-Mode Traefik) ---
CRM_DOMAIN=crm.kpproperties.co.in
CRM_HOST_PORT=3000

# --- Database (Supabase PostgreSQL) ---
# DATABASE_URL: Transaction Pooler (port 6543) with pgbouncer=true & statement_cache_size=0
DATABASE_URL=
# DIRECT_URL: Session Pooler / Direct Connection (port 5432) for Prisma introspection/migrations
DIRECT_URL=

# --- Authentication (Auth.js / NextAuth v5) ---
AUTH_SECRET=
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://crm.kpproperties.co.in
AUTH_URL=https://crm.kpproperties.co.in
NEXT_PUBLIC_APP_URL=https://crm.kpproperties.co.in

# --- Object Storage (Cloudflare R2 - Mandatory) ---
STORAGE_PROVIDER=R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_SIGNED_URL_EXPIRY_SECONDS=300
R2_PUBLIC_BASE_URL=

# --- Redis & Rate Limiting ---
# Set REDIS_URL to external Upstash / managed Redis instance (fails open if omitted)
REDIS_URL=

# --- Internal Automation & Cron ---
# Bearer token for GET/POST /api/internal/notifications/sweep
CRON_SECRET=

# --- WhatsApp Integration ---
# Default to MOCK or CLICK_TO_CHAT until Meta Cloud API is verified
WHATSAPP_PROVIDER=MOCK
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_WEBHOOK_ENABLED=true
WHATSAPP_APPROVED_TEMPLATE_NAMES=
WHATSAPP_TEST_RECIPIENT=

# --- Property Portals ---
ACRES_99_API_KEY=
MAGICBRICKS_API_KEY=

# --- Google Maps & Routing ---
MAPS_PROVIDER=DISABLED
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_DEFAULT_CITY=Delhi
GOOGLE_MAPS_DEFAULT_REGION=IN
GOOGLE_MAPS_DEFAULT_LANGUAGE=en

# --- Error Tracking / Sentry (Optional) ---
SENTRY_DSN=

# --- SMTP / Email (Optional) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
