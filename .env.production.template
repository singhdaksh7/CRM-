# ==============================================================================
# KP PROPERTIES CRM - HOSTINGER VPS PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Lives on the VPS only, at /opt/kp-crm/env/.env.production (chmod 600):
#   deploy/scripts/02-gen-env.sh creates it from this template and fills the
#   generated secrets (POSTGRES_PASSWORD, REDIS_PASSWORD, CRON_SECRET, AUTH_SECRET).
# Anything marked PRIVATE must be typed on the server by you - never in chat,
# never in Git. All passwords below are generated as hex so they are URL-safe.
# ==============================================================================

# --- Node & runtime ---
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# --- Public hostname (temporary sslip.io now; permanent domain later) ---
# Changing the hostname means editing these four values and REBUILDING
# (NEXT_PUBLIC_* and the CSP are baked at build time).
CRM_DOMAIN=kpcrm.77.37.45.177.sslip.io
NEXTAUTH_URL=https://kpcrm.77.37.45.177.sslip.io
AUTH_URL=https://kpcrm.77.37.45.177.sslip.io
NEXT_PUBLIC_APP_URL=https://kpcrm.77.37.45.177.sslip.io
AUTH_TRUST_HOST=true

# --- PostgreSQL 17 (container "postgres" on the internal backend network) ---
POSTGRES_USER=kpcrm
POSTGRES_DB=kpcrm
POSTGRES_PASSWORD=__GENERATED__
# Prisma needs BOTH; locally they are the same (no PgBouncer in this stack).
DATABASE_URL=postgresql://kpcrm:__POSTGRES_PASSWORD__@postgres:5432/kpcrm?schema=public
DIRECT_URL=postgresql://kpcrm:__POSTGRES_PASSWORD__@postgres:5432/kpcrm?schema=public

# --- Redis 7 (container "redis"; rate limiting + caches + sweep lock) ---
REDIS_PASSWORD=__GENERATED__
REDIS_URL=redis://:__REDIS_PASSWORD__@redis:6379

# --- Auth.js ---
# Reuse the previous production AUTH_SECRET if you still have it (keeps sessions);
# otherwise a new one is generated and everyone must sign in again.
AUTH_SECRET=__GENERATED__

# --- Internal automation ---
# Bearer token for /api/internal/notifications/sweep (host cron calls it).
CRON_SECRET=__GENERATED__

# --- Cloudflare R2 (existing business-media bucket) ---
STORAGE_PROVIDER=R2
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
# PRIVATE: set on the server only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_URL_EXPIRY_SECONDS=300
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# --- WhatsApp: deliberate employee-click workflow only. NO automatic sending. ---
WHATSAPP_PROVIDER=MOCK
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_APPROVED_TEMPLATE_NAMES=
WHATSAPP_TEST_RECIPIENT=

# --- Property portals ---
ACRES_99_API_KEY=
MAGICBRICKS_API_KEY=

# --- Google Maps ---
MAPS_PROVIDER=DISABLED
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_DEFAULT_CITY=Delhi
GOOGLE_MAPS_DEFAULT_REGION=IN
GOOGLE_MAPS_DEFAULT_LANGUAGE=en

# --- Optional ---
SENTRY_DSN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
