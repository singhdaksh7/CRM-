# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite database + backups
/prisma/dev.db
/prisma/dev.db-journal
/prisma/backups/
prisma/**/*.db
prisma/**/*.db-journal

# local document uploads (Phase 2 document vault, local storage provider)
/public/uploads/

# Firebase service-account keys - never commit these (see DEPLOYMENT.md
# "2.4 Firebase Storage provider"). Credentials go in FIREBASE_PRIVATE_KEY
# etc. env vars, not a JSON file in the repo.
*firebase-adminsdk*.json
serviceAccountKey.json
firebase-service-account*.json

.vercel
